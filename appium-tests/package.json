{
  "name": "netadaptive-appium-tests",
  "version": "1.0.0",
  "description": "Appium E2E tests for NetAdaptive Android App",
  "main": "index.js",
  "scripts": {
    "test": "wdio run ./config/wdio.conf.js",
    "test:smoke": "wdio run ./config/wdio.conf.js --spec ./tests/smoke/*.test.js",
    "test:e2e": "wdio run ./config/wdio.conf.js --spec ./tests/e2e/*.test.js",
    "report": "node ./utils/initializeReport.js"
  },
  "dependencies": {
    "@wdio/appium-service": "^8.0.0",
    "@wdio/cli": "^8.0.0",
    "@wdio/local-runner": "^8.0.0",
    "@wdio/mocha-framework": "^8.0.0",
    "@wdio/spec-reporter": "^8.0.0",
    "appium": "^3.0.0-rc.2",
    "chai": "^4.3.7",
    "exceljs": "^4.3.0",
    "webdriverio": "^8.0.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
